DATABASE_URL=postgresql://raglab:raglab@localhost:5432/raglab
CORS_ORIGINS=["http://localhost:3000"]
# Local-only API. Set false for a read-only public deployment.
PRIVATE_UPLOADS_ENABLED=true
# Optional: set only after downloading the pinned embedding model.
EMBEDDING_MODEL_PATH=
# Opt in to local generation after pulling a model and starting Ollama.
GENERATION_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELS=["qwen2.5:1.5b"]
GENERATION_TIMEOUT_SECONDS=90
GENERATION_MAX_TOKENS=384
